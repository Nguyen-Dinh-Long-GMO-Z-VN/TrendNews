# Investment Analysis AI Configuration
# Copy file này thành .env và điền API key

# ===== OPTION 1: Dùng Claude (Anthropic) - KHUYẾN NGHỊ =====
AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-your-key-here
# AI_MODEL=claude-haiku-4-5         # nhanh, rẻ (mặc định)
# AI_MODEL=claude-sonnet-4-6        # thông minh hơn, đắt hơn

# ===== OPTION 2: Dùng DeepSeek - rẻ nhất =====
# AI_PROVIDER=deepseek
# AI_API_KEY=sk-your-deepseek-key

# ===== OPTION 3: Dùng OpenAI =====
# AI_PROVIDER=openai
# AI_API_KEY=sk-your-openai-key
# AI_MODEL=gpt-4o-mini

# ===== OPTION 4: Dùng Ollama (local, miễn phí) =====
# AI_PROVIDER=ollama
# AI_MODEL=llama3.2
# AI_BASE_URL=http://localhost:11434

# ═══════════════════════════════════════════════════════════
# Translation — dịch tiêu đề sang tiếng Việt (Gemini trực tiếp)
# Lấy API key miễn phí tại https://aistudio.google.com/apikey
# ═══════════════════════════════════════════════════════════
# TRANSLATE_PROVIDER=gemini          # mặc định gemini cho feature riêng
# GOOGLE_API_KEY=AIza-your-key-here  # hoặc TRANSLATE_API_KEY=...
# TRANSLATE_MODEL=gemini-3.5-flash   # mặc định, đủ dùng cho dịch batch
# TRANSLATION_ENABLED=true           # bật không cần sửa config.yaml

# ═══════════════════════════════════════════════════════════
# AI Filter — lọc tin theo config/ai_interests.txt
# ═══════════════════════════════════════════════════════════
# AIFILTER_PROVIDER=gemini
# AIFILTER_API_KEY=...               # fallback: GOOGLE_API_KEY → AI_API_KEY
# AIFILTER_MODEL=gemini-3.5-flash
# AI_FILTER_ENABLED=true             # bật không cần sửa config.yaml
# AI_INTERESTS_PATH=config/ai_interests.txt

# DEDUP_ENABLED=false                # tắt dedup xuyên nguồn nếu cần
